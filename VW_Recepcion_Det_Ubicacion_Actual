--#CKFK20261023 Nueva funcionalidad en reporte de ingresos
SET ANSI_NULLS ON;
SET QUOTED_IDENTIFIER ON;
GO
DECLARE @Definition nvarchar(max) = OBJECT_DEFINITION(OBJECT_ID(N'dbo.VW_Recepcion_Det', N'V'));
IF @Definition IS NULL THROW 50000, 'No se pudo leer VW_Recepcion_Det.', 1;
DECLARE @Start int = CHARINDEX(N'SELECT pb.IdBodega', @Definition);
IF @Start = 0 THROW 50001, 'La definición del reporte cambió. Revisar antes de instalar.', 1;
DECLARE @Select nvarchar(max) = SUBSTRING(@Definition, @Start, LEN(@Definition));
SET @Select = STUFF(@Select, 7, 0, N' re_det.IdRecepcionDet, re_det.IdProductoBodega, ');
DECLARE @SQL nvarchar(max) = N'CREATE OR ALTER VIEW dbo.VW_Recepcion_Det_Ubicacion_Actual AS ' + @Select;
EXEC sys.sp_executesql @SQL;
GO
