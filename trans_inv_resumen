        SELECT 1
        FROM sys.indexes
        WHERE object_id = OBJECT_ID(N'dbo.trans_inv_resumen')
          AND name = N'UX_trans_inv_resumen_IdSolicitud'
          AND is_unique = 1
          AND type = 2
          AND has_filter = 1
          AND filter_definition = N'([IdSolicitud] IS NOT NULL)'
