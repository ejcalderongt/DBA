DECLARE @FilasEsperadas bigint = 27;
DECLARE @FilasActuales bigint;
DECLARE @MaxId int;
DECLARE @ResultadoBloqueo int;

BEGIN TRY
    BEGIN TRANSACTION;

    EXEC @ResultadoBloqueo = sys.sp_getapplock
        @Resource = N'TOMWMS_TRANS_INV_RESUMEN_IDENTITY_SCHEMA_CHANGE',
        @LockMode = N'Exclusive',
        @LockOwner = N'Transaction',
        @LockTimeout = 30000;

    IF @ResultadoBloqueo < 0
        THROW 51017, 'No fue posible obtener el bloqueo exclusivo.', 1;

    SELECT
        @FilasActuales = COUNT_BIG(idinventariores),
        @MaxId = ISNULL(MAX(idinventariores), 0)
    FROM dbo.trans_inv_resumen WITH (TABLOCKX, HOLDLOCK);

    IF @FilasActuales <> @FilasEsperadas
        THROW 51018, 'La tabla ya no contiene los 27 registros validados.', 1;

    IF EXISTS
    (
        SELECT idinventariores
        FROM dbo.trans_inv_resumen
        GROUP BY idinventariores
        HAVING COUNT_BIG(idinventariores) > 1
    )
        THROW 51019, 'Existen IDs duplicados.', 1;

    IF EXISTS
    (
        SELECT IdSolicitud
        FROM dbo.trans_inv_resumen
        WHERE IdSolicitud IS NOT NULL
        GROUP BY IdSolicitud
        HAVING COUNT_BIG(IdSolicitud) > 1
    )
        THROW 51020, 'Existen IdSolicitud duplicados.', 1;

    CREATE TABLE dbo.trans_inv_resumen_identity_migration_stage
    (
        idinventariores      int IDENTITY(1,1) NOT NULL,
        idinventarioenct     int NOT NULL,
        idtramo              int NOT NULL,
        idproducto           int NOT NULL,
        idoperador           int NULL,
        IdUnidadMedida       int NULL,
        idpresentacion       int NULL,
        idproductoestado     int NULL,
        cantidad             float NULL,
        fecha_captura        datetime NULL,
        host                 nvarchar(50) COLLATE Modern_Spanish_CI_AS NULL,
        nom_producto         nvarchar(250) COLLATE Modern_Spanish_CI_AS NULL,
        nom_operador         nvarchar(50) COLLATE Modern_Spanish_CI_AS NULL,
        idbodega             int NOT NULL,
        idubicacion          int NOT NULL,
        lic_plate            nvarchar(100) COLLATE Modern_Spanish_CI_AS NULL,
        IdProductoTallaColor int NULL,
        IdSolicitud          varchar(36) COLLATE Modern_Spanish_CI_AS NULL
    ) ON [PRIMARY];

    SET IDENTITY_INSERT
        dbo.trans_inv_resumen_identity_migration_stage ON;

    INSERT INTO dbo.trans_inv_resumen_identity_migration_stage
    (
        idinventariores,
        idinventarioenct,
        idtramo,
        idproducto,
        idoperador,
        IdUnidadMedida,
        idpresentacion,
        idproductoestado,
        cantidad,
        fecha_captura,
        host,
        nom_producto,
        nom_operador,
        idbodega,
        idubicacion,
        lic_plate,
        IdProductoTallaColor,
        IdSolicitud
    )
    SELECT
        idinventariores,
        idinventarioenct,
        idtramo,
        idproducto,
        idoperador,
        IdUnidadMedida,
        idpresentacion,
        idproductoestado,
        cantidad,
        fecha_captura,
        host,
        nom_producto,
        nom_operador,
        idbodega,
        idubicacion,
        lic_plate,
        IdProductoTallaColor,
        IdSolicitud
    FROM dbo.trans_inv_resumen;

    SET IDENTITY_INSERT
        dbo.trans_inv_resumen_identity_migration_stage OFF;

    IF
    (
        SELECT COUNT_BIG(idinventariores)
        FROM dbo.trans_inv_resumen_identity_migration_stage
    ) <> @FilasActuales
        THROW 51021, 'La cantidad de registros copiados no coincide.', 1;

    -- Original menos etapa.
    IF EXISTS
    (
        SELECT
            idinventariores, idinventarioenct, idtramo, idproducto,
            idoperador, IdUnidadMedida, idpresentacion, idproductoestado,
            cantidad, fecha_captura, host, nom_producto, nom_operador,
            idbodega, idubicacion, lic_plate, IdProductoTallaColor,
            IdSolicitud
        FROM dbo.trans_inv_resumen

        EXCEPT

        SELECT
            idinventariores, idinventarioenct, idtramo, idproducto,
            idoperador, IdUnidadMedida, idpresentacion, idproductoestado,
            cantidad, fecha_captura, host, nom_producto, nom_operador,
            idbodega, idubicacion, lic_plate, IdProductoTallaColor,
            IdSolicitud
        FROM dbo.trans_inv_resumen_identity_migration_stage
    )
        THROW 51022, 'La etapa no contiene todos los registros originales.', 1;

    -- Etapa menos original.
    IF EXISTS
    (
        SELECT
            idinventariores, idinventarioenct, idtramo, idproducto,
            idoperador, IdUnidadMedida, idpresentacion, idproductoestado,
            cantidad, fecha_captura, host, nom_producto, nom_operador,
            idbodega, idubicacion, lic_plate, IdProductoTallaColor,
            IdSolicitud
        FROM dbo.trans_inv_resumen_identity_migration_stage

        EXCEPT

        SELECT
            idinventariores, idinventarioenct, idtramo, idproducto,
            idoperador, IdUnidadMedida, idpresentacion, idproductoestado,
            cantidad, fecha_captura, host, nom_producto, nom_operador,
            idbodega, idubicacion, lic_plate, IdProductoTallaColor,
            IdSolicitud
        FROM dbo.trans_inv_resumen
    )
        THROW 51023, 'La etapa contiene registros distintos o adicionales.', 1;

    DROP TABLE dbo.trans_inv_resumen;

    EXEC sys.sp_rename
        N'dbo.trans_inv_resumen_identity_migration_stage',
        N'trans_inv_resumen',
        N'OBJECT';

    ALTER TABLE dbo.trans_inv_resumen
        ADD CONSTRAINT DF_inv_ini_resumen_cant
        DEFAULT ((0)) FOR cantidad;

    ALTER TABLE dbo.trans_inv_resumen
        ADD CONSTRAINT DF__trans_inv__idbod__54F9AAF4
        DEFAULT ((0)) FOR idbodega;

    ALTER TABLE dbo.trans_inv_resumen
        ADD CONSTRAINT DF__trans_inv__idubi__55EDCF2D
        DEFAULT ((0)) FOR idubicacion;

    ALTER TABLE dbo.trans_inv_resumen
        ADD CONSTRAINT PK_trans_inv_ini_resumen
        PRIMARY KEY CLUSTERED (idinventariores ASC)
        WITH
        (
            PAD_INDEX = OFF,
            STATISTICS_NORECOMPUTE = OFF,
            IGNORE_DUP_KEY = OFF,
            ALLOW_ROW_LOCKS = ON,
            ALLOW_PAGE_LOCKS = ON,
            OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF
        ) ON [PRIMARY];

    CREATE UNIQUE NONCLUSTERED INDEX UX_trans_inv_resumen_IdSolicitud
        ON dbo.trans_inv_resumen (IdSolicitud ASC)
        WHERE IdSolicitud IS NOT NULL
        WITH
        (
            PAD_INDEX = OFF,
            STATISTICS_NORECOMPUTE = OFF,
            IGNORE_DUP_KEY = OFF,
            ALLOW_ROW_LOCKS = ON,
            ALLOW_PAGE_LOCKS = ON,
            OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF
        ) ON [PRIMARY];

    ALTER TABLE dbo.trans_inv_resumen WITH CHECK
        ADD CONSTRAINT FK_inv_ini_resumen_inv_enc
        FOREIGN KEY (idinventarioenct)
        REFERENCES dbo.trans_inv_enc (idinventarioenc)
        ON DELETE CASCADE;

    ALTER TABLE dbo.trans_inv_resumen
        CHECK CONSTRAINT FK_inv_ini_resumen_inv_enc;

    DECLARE @ComandoReseed nvarchar(300);

    SET @ComandoReseed =
        N'DBCC CHECKIDENT (''dbo.trans_inv_resumen'', RESEED, ' +
        CONVERT(nvarchar(20), @MaxId) +
        N') WITH NO_INFOMSGS;';

    EXEC sys.sp_executesql @ComandoReseed;

    EXEC sys.sp_refreshsqlmodule N'dbo.CLBD_INICIARBD';
    EXEC sys.sp_refreshsqlmodule N'dbo.CLBD_PRC';
    EXEC sys.sp_refreshsqlmodule N'dbo.CLBD_PRC_BY_IDBODEGA';

    UPDATE @ColumnasEsperadas
    SET identity_val = 1
    WHERE column_id = 1;

    -- Estructura final bidireccional.
    IF EXISTS
    (
        SELECT
            e.column_id, e.nombre, e.tipo, e.max_length,
            e.precision_val, e.scale_val, e.nullable,
            e.collation_name, e.identity_val, e.computed_val,
            e.rowguid_val, e.sparse_val
        FROM @ColumnasEsperadas e

        EXCEPT

        SELECT
            c.column_id, c.name, TYPE_NAME(c.user_type_id),
            c.max_length, c.precision, c.scale, c.is_nullable,
            c.collation_name, c.is_identity, c.is_computed,
            c.is_rowguidcol, c.is_sparse
        FROM sys.columns c
        WHERE c.object_id = OBJECT_ID(N'dbo.trans_inv_resumen')
    )
    OR EXISTS
    (
        SELECT
            c.column_id, c.name, TYPE_NAME(c.user_type_id),
            c.max_length, c.precision, c.scale, c.is_nullable,
            c.collation_name, c.is_identity, c.is_computed,
            c.is_rowguidcol, c.is_sparse
        FROM sys.columns c
        WHERE c.object_id = OBJECT_ID(N'dbo.trans_inv_resumen')

        EXCEPT

        SELECT
            e.column_id, e.nombre, e.tipo, e.max_length,
            e.precision_val, e.scale_val, e.nullable,
            e.collation_name, e.identity_val, e.computed_val,
            e.rowguid_val, e.sparse_val
        FROM @ColumnasEsperadas e
    )
        THROW 51024, 'La estructura final no coincide.', 1;

    IF (SELECT COUNT_BIG(idinventariores)
        FROM dbo.trans_inv_resumen) <> @FilasActuales
        THROW 51025, 'La cantidad final de registros no coincide.', 1;

    IF (SELECT COUNT(*)
        FROM sys.default_constraints
        WHERE parent_object_id = OBJECT_ID(N'dbo.trans_inv_resumen')) <> 3
        THROW 51026, 'Los defaults finales no coinciden.', 1;

    IF (SELECT COUNT(*)
        FROM sys.indexes
        WHERE object_id = OBJECT_ID(N'dbo.trans_inv_resumen')
          AND index_id > 0) <> 2
