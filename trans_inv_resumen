    IF NOT EXISTS
    (
        SELECT 1
        FROM sys.foreign_keys
        WHERE name = N'FK_inv_ini_resumen_inv_enc'
          AND parent_object_id = OBJECT_ID(N'dbo.trans_inv_resumen')
