    -- Dependencias después de reconstruir y refrescar.
    IF EXISTS
    (
        SELECT e.objeto
        FROM @DependenciasEsperadas e

        EXCEPT

        SELECT DISTINCT
            QUOTENAME(OBJECT_SCHEMA_NAME(d.referencing_id)) +
            N'.' +
            QUOTENAME(OBJECT_NAME(d.referencing_id))
        FROM sys.sql_expression_dependencies d
        WHERE d.referenced_id = OBJECT_ID(N'dbo.trans_inv_resumen')
          AND d.referencing_id <> OBJECT_ID(N'dbo.trans_inv_resumen')
    )
    OR EXISTS
    (
        SELECT DISTINCT
            QUOTENAME(OBJECT_SCHEMA_NAME(d.referencing_id)) +
            N'.' +
            QUOTENAME(OBJECT_NAME(d.referencing_id))
        FROM sys.sql_expression_dependencies d
        WHERE d.referenced_id = OBJECT_ID(N'dbo.trans_inv_resumen')
          AND d.referencing_id <> OBJECT_ID(N'dbo.trans_inv_resumen')

        EXCEPT

        SELECT e.objeto
        FROM @DependenciasEsperadas e
    )
        THROW 51031, 'Las dependencias no quedaron asociadas a la tabla reconstruida.', 1;

    IF IDENT_CURRENT(N'dbo.trans_inv_resumen') <> @MaxId
        THROW 51032, 'El valor actual de IDENTITY no coincide con el máximo histórico.', 1;

    IF EXISTS
    (
        SELECT IdSolicitud
        FROM dbo.trans_inv_resumen
        WHERE IdSolicitud IS NOT NULL
        GROUP BY IdSolicitud
        HAVING COUNT_BIG(IdSolicitud) > 1
    )
        THROW 51033, 'Se detectaron IdSolicitud duplicados al finalizar.', 1;

    COMMIT TRANSACTION;

    SELECT
        DB_NAME() AS BaseDatos,
        COUNT_BIG(idinventariores) AS Registros,
        MIN(idinventariores) AS IdMinimo,
        MAX(idinventariores) AS IdMaximo,
        IDENT_CURRENT(N'dbo.trans_inv_resumen') AS IdentityActual,
        COLUMNPROPERTY(
            OBJECT_ID(N'dbo.trans_inv_resumen'),
            N'idinventariores',
            'IsIdentity') AS EsIdentity
    FROM dbo.trans_inv_resumen;

    SELECT DISTINCT
        QUOTENAME(OBJECT_SCHEMA_NAME(d.referencing_id)) +
        N'.' +
        QUOTENAME(OBJECT_NAME(d.referencing_id)) AS DependenciaVerificada
    FROM sys.sql_expression_dependencies d
    WHERE d.referenced_id = OBJECT_ID(N'dbo.trans_inv_resumen')
      AND d.referencing_id <> OBJECT_ID(N'dbo.trans_inv_resumen')
    ORDER BY DependenciaVerificada;

END TRY
BEGIN CATCH
    IF XACT_STATE() <> 0
        ROLLBACK TRANSACTION;

    THROW;
END CATCH;
GO

